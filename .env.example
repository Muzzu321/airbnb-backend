# Copy to .env and fill in. NEVER commit the real .env file.
# Load into your shell before starting the backend:   set -a; source .env; set +a

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/airBnb
DB_USERNAME=airbnb_user
DB_PASSWORD=change-me

# --- Security ---
# At least 32 characters, random. Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars

# --- Frontend / CORS / cookies ---
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY=sk_test_replace_me
# Printed by `stripe listen --forward-to localhost:8080/api/v1/webhook/payment`
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- Optional ---
# JPA_DDL_AUTO=update
# JPA_SHOW_SQL=false
# SERVER_PORT=8080
